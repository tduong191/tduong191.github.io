---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			ul.posts {
				list-style: none;
				padding: 0;
			}
			ul.posts li {
				margin-bottom: 1rem;
			}
			ul.posts .blurb {
				margin: 0;
				font-size: 0.9em;
				line-height: 1.5;
			}
			ul.posts .date {
				margin: 0;
				color: rgb(var(--gray));
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>AI inside the tools you already use</h1>
			<p>
				I build small things that make AI useful without asking you to adopt another app: a
				spreadsheet, a Shortcut, a note. Every post shows what I used, how it works, how to copy
				it, and what broke.
			</p>
			<h2>Latest posts</h2>
			<ul class="posts">
				{
					posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>{post.data.title}</a>
							<p class="blurb">{post.data.description}</p>
							<p class="date">
								<FormattedDate date={post.data.pubDate} />
							</p>
						</li>
					))
				}
			</ul>
			<p><a href="/blog/">All posts</a> · <a href="/rss.xml">RSS</a></p>
		</main>
		<Footer />
	</body>
</html>
